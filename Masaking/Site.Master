<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Masaking.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <link runat="server" href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link runat="server" href="~/Content/css/navbar-controls.css" rel="stylesheet" />
    <link runat="server" href="~/Content/css/mobile-artwork.css" rel="stylesheet" />
    <link runat="server" href="~/Content/css/back-links.css" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager ID="SiteScriptManager" runat="server">
            <Scripts>
                <asp:ScriptReference Path="~/Scripts/modernizr-2.8.3.js" />
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <asp:ScriptReference Path="~/Scripts/bootstrap.js" />
                <asp:ScriptReference Path="~/Scripts/site-nav.js" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm site-header">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/">
                    <img runat="server" src="~/Content/images/Masaking Logo.png" alt="Masaking" width="100" height="24" class="mb-1"></a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#siteNavbar" title="Toggle navigation" aria-controls="siteNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="siteNavbar" class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">Home</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Recipes/BrowseRecipes">Recipes</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Learning/Default">Learn</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Community/Community">Community</a></li>
                        <asp:PlaceHolder ID="phMyRecipesNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Recipes/MyRecipes">My Recipes</a></li>
                        </asp:PlaceHolder>
                    </ul>
                    <asp:PlaceHolder ID="phGuestNav" runat="server">
                    <ul class="navbar-nav flex-row align-items-center flex-grow-1 justify-content-end gap-3 gap-sm-2 mt-2 mt-sm-0 pb-2 pb-sm-0">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Account/Login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-primary" runat="server" href="~/Account/Register">Sign Up</a></li>
                    </ul>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder ID="phAuthenticatedNav" runat="server" Visible="false">
                        <div class="site-nav-member-actions d-flex align-items-center gap-3 ms-sm-auto">
                            <div id="navSearch" runat="server" class="site-nav-search input-group flex-nowrap border rounded-pill overflow-hidden" role="search" data-nav-search>
                                <button type="button" class="site-nav-search-submit btn border-0 bg-transparent px-3" data-nav-search-submit aria-label="Search recipes and community posts"><i class="bi bi-search" aria-hidden="true"></i></button>
                                <label for="siteSearchInput" class="visually-hidden">Search recipes and community posts</label>
                                <input id="siteSearchInput" type="search" class="form-control border-0 bg-transparent shadow-none ps-0 pe-3" maxlength="100" placeholder="Search recipes or posts…" autocomplete="off" />
                            </div>
                            <asp:HyperLink ID="lnkNavProfile" runat="server" NavigateUrl="~/Account/Profile.aspx" class="site-nav-profile" aria-label="Open my profile">
                                <asp:Label ID="lblNavInitials" runat="server" class="site-nav-initials" aria-hidden="true" />
                                <asp:Image ID="imgNavAvatar" runat="server" class="site-nav-avatar" AlternateText="Your profile" />
                                <asp:PlaceHolder ID ="phAdminDashboardIcon"  runat="server" Visible="false"> 
                                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                </asp:PlaceHolder>
                            </asp:HyperLink>
                        </div>
                    </asp:PlaceHolder>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <asp:Label ID="lblCopyrightYear" runat="server" class="d-inline" /> - Masaking</p>
            </footer>
        </div>
    </form>
</body>
</html>
