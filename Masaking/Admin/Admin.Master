<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="Masaking.Admin.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Masaking</title>
    <link runat="server" href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link runat="server" href="~/Content/Site.css" rel="stylesheet" />
    <link runat="server" href="~/Content/css/admin.css" rel="stylesheet" />
    <link runat="server" href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="admin-layout">
            <aside class="admin-sidebar">
                <asp:HyperLink ID="lnkBrand" runat="server" NavigateUrl="~/Default.aspx" CssClass="admin-brand" Text="Masaking" />
                <p class="small">Administration</p>

                <nav aria-label="Administrator navigation">
                    <asp:HyperLink ID="lnkDashboard" runat="server" NavigateUrl="~/Admin/Dashboard.aspx" Text="Dashboard" />
                    <asp:HyperLink ID="lnkRecipes" runat="server" NavigateUrl="~/Admin/ManageRecipes.aspx" Text="Manage recipes" />
                    <asp:HyperLink ID="lnkUsers" runat="server" NavigateUrl="~/Admin/ManageUsers.aspx" Text="Manage users" />
                    <asp:HyperLink ID="lnkCommunity" runat="server" NavigateUrl="~/Admin/ManageCommunity.aspx" Text="Moderate community" />
                    <asp:HyperLink ID="lnkQuizzes" runat="server" NavigateUrl="~/Admin/ManageChallenges.aspx" Text="Manage quizzes" />
                    <asp:HyperLink ID="lnkSimulations" runat="server" NavigateUrl="~/Admin/ManageSimulations.aspx" Text="Manage simulations" />
                    <asp:HyperLink ID="lnkWebsite" runat="server" NavigateUrl="~/Default.aspx" Text="Back to website" />
                </nav>
            </aside>

            <main class="admin-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </form>
    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
</body>
</html>
